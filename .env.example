# Copy to .env and fill in. Nothing here is read by the published Symbols
# surfaces at runtime — packages/brand/functions/backend.js carries the
# Supabase URL and publishable key itself (both public by design; RLS
# protects the data). These vars serve local scripts, tests, and the
# service layer in lib/.

# ===========================================
# SUPABASE (project qetdqwmmnpmgrixkorqg — the live aurc.app backend)
# ===========================================

SUPABASE_URL=https://qetdqwmmnpmgrixkorqg.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Server-only. Bypasses RLS — never expose to a client.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Demo dashboard account (used for manual sign-in testing)
FRACTYCO_DEMO_EMAIL=demo@fractyco.app
FRACTYCO_DEMO_PASSWORD=your_demo_password_here

# ===========================================
# SOLANA
# ===========================================

# Keypair used by scripts and integration tests. Secret.
WALLET_PRIVATE_KEY=your_wallet_private_key_here

SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional paid RPC — takes precedence over SOLANA_RPC_URL when set
# ALCHEMY_RPC_URL=https://solana-devnet.g.alchemy.com/v2/your_alchemy_api_key_here

# Program addresses (defaults baked into lib/web3/config/programs.ts)
# PROJECT_REGISTRY_PROGRAM_ID=Dkrnk6B8MuiieXQzqhicbsPtGp7TY4HMZRNDJJFhu4R7
# COMPLIANCE_PROGRAM_ID=5u14TuRE7ozsKketfqF4R7XPvi7bof9RA455VcKME3Vy
# ALLOCATION_DISTRIBUTION_PROGRAM_ID=9RqVyvWA4ficqK351PoYh674mP1au4NmNzVM6LQcenjm
# SECONDARY_MARKET_PROGRAM_ID=your_secondary_market_program_id

# Mints and wallets (defaults baked into lib/web3 + tests)
# USDC_MINT=AJujcxZiQ1jUvSixiFLQNWFCpUtMuVsbyPCQ8ByU3jvf
# TREASURY_WALLET=7STXs2LXLimTiPBuvrcnE1u7vQFCw9GoCKmhs3QsuSk4

# ===========================================
# KYC (Sumsub — used by lib/sumsub/client.ts)
# ===========================================

SUMSUB_APP_TOKEN=your_sumsub_app_token_here
SUMSUB_SECRET_KEY=your_sumsub_secret_key_here
