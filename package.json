{
  "name": "fractyco",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "bun scripts/run.mjs start",
    "build": "bun scripts/run.mjs build",
    "publish:all": "bun scripts/run.mjs publish",
    "start:landing": "bun run --filter @fractyco/landing start",
    "start:dashboard": "bun run --filter @fractyco/dashboard start",
    "start:governance": "bun run --filter @fractyco/governance start",
    "docs:sync": "bun scripts/sync-notes.mjs",
    "docs:push": "bun scripts/sync-notes.mjs && cd packages/landing && bunx smbls docs push",
    "sync-idl": "cp programs/project_registry/src/idl.json lib/web3/idl/project_registry.json && cp programs/compliance_transfer/src/idl.json lib/web3/idl/compliance_transfer.json && cp programs/allocation_distribution/src/idl.json lib/web3/idl/allocation_distribution.json && cp programs/secondary_market/src/idl.json lib/web3/idl/secondary_market.json && echo \"IDLs synced.\"",
    "patch-idl:registry": "bunx tsx scripts/patch-idl.ts project_registry",
    "patch-idl:compliance": "bunx tsx scripts/patch-idl.ts compliance_transfer",
    "patch-idl:distribution": "bunx tsx scripts/patch-idl.ts allocation_distribution",
    "verify-user": "bunx tsx scripts/manual-verify.ts",
    "indexer": "bunx tsx scripts/indexer_watcher.ts",
    "test:eligibility": "cross-env NODE_OPTIONS=\"--import tsx\" mocha tests/eligibility.ts --timeout 100000",
    "test:subscription": "cross-env NODE_OPTIONS=\"--import tsx\" mocha tests/subscription.ts --timeout 100000",
    "test:tokenization": "cross-env NODE_OPTIONS=\"--import tsx\" mocha tests/tokenization.ts --timeout 100000",
    "test:secondary-market": "cross-env NODE_OPTIONS=\"--import tsx\" mocha tests/secondary-market.ts --timeout 150000",
    "test:full-flow": "cross-env NODE_OPTIONS=\"--import tsx\" bunx tsx tests/simulate-full-flow.ts",
    "start:brand": "bun run --filter @fractyco/brand start"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.29.0",
    "@metaplex-foundation/mpl-token-metadata": "^2.13.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/spl-token-metadata": "^0.1.6",
    "@solana/web3.js": "^1.98.4",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.94.0",
    "@types/bs58": "^4.0.4",
    "@types/pg": "^8.20.0",
    "bs58": "^6.0.0",
    "dotenv": "^17.4.2",
    "pg": "^8.21.0",
    "smbls": "^3.14.0",
    "tweetnacl": "^1.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^25.0.10",
    "cross-env": "^10.1.0",
    "mocha": "^11.7.5",
    "parcel": "^2.16.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.14"
}
