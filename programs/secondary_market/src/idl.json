{
  "version": "0.1.0",
  "name": "secondary_market",
  "instructions": [
    {
      "name": "initializeMarket",
      "accounts": [
        { "name": "config", "isMut": true, "isSigner": false },
        { "name": "feeDestination", "isMut": false, "isSigner": false },
        { "name": "admin", "isMut": true, "isSigner": true },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "feeBasisPoints", "type": "u16" },
        { "name": "projectRegistryProgram", "type": "publicKey" },
        { "name": "complianceProgram", "type": "publicKey" },
        { "name": "distributionProgram", "type": "publicKey" }
      ]
    },
    {
      "name": "updateMarketConfig",
      "accounts": [
        { "name": "config", "isMut": true, "isSigner": false },
        { "name": "authority", "isMut": false, "isSigner": true }
      ],
      "args": [
        { "name": "feeBasisPoints", "type": { "option": "u16" } },
        { "name": "isPaused", "type": { "option": "bool" } },
        { "name": "feeDestination", "type": { "option": "publicKey" } }
      ]
    },
    {
      "name": "setProjectPause",
      "accounts": [
        { "name": "config", "isMut": false, "isSigner": false },
        { "name": "authority", "isMut": true, "isSigner": true },
        { "name": "projectMint", "isMut": false, "isSigner": false },
        { "name": "projectPause", "isMut": true, "isSigner": false },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [{ "name": "isPaused", "type": "bool" }]
    },
    {
      "name": "createSellOrder",
      "accounts": [
        { "name": "config", "isMut": false, "isSigner": false },
        { "name": "seller", "isMut": true, "isSigner": true },
        { "name": "sellerTokenAccount", "isMut": true, "isSigner": false },
        { "name": "projectMint", "isMut": false, "isSigner": false },
        { "name": "escrowVault", "isMut": true, "isSigner": false },
        { "name": "vaultAuthority", "isMut": false, "isSigner": false },
        { "name": "sellOrder", "isMut": true, "isSigner": false },
        { "name": "projectAccount", "isMut": false, "isSigner": false },
        { "name": "sellerEligibility", "isMut": false, "isSigner": false },
        { "name": "projectPause", "isMut": false, "isSigner": false },
        { "name": "distributionControl", "isMut": false, "isSigner": false },
        { "name": "tokenProgram", "isMut": false, "isSigner": false },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "amount", "type": "u64" },
        { "name": "pricePerToken", "type": "u64" },
        { "name": "sequence", "type": "u64" }
      ]
    },
    {
      "name": "cancelSellOrder",
      "accounts": [
        { "name": "sellOrder", "isMut": true, "isSigner": false },
        { "name": "seller", "isMut": true, "isSigner": false },
        { "name": "sellerTokenAccount", "isMut": true, "isSigner": false },
        { "name": "projectMint", "isMut": false, "isSigner": false },
        { "name": "escrowVault", "isMut": true, "isSigner": false },
        { "name": "vaultAuthority", "isMut": false, "isSigner": false },
        { "name": "config", "isMut": false, "isSigner": false },
        { "name": "projectAccount", "isMut": false, "isSigner": false },
        { "name": "tokenProgram", "isMut": false, "isSigner": false }
      ],
      "args": []
    },
    {
      "name": "fillOrder",
      "accounts": [
        { "name": "config", "isMut": false, "isSigner": false },
        { "name": "buyer", "isMut": true, "isSigner": true },
        { "name": "buyerTokenAccount", "isMut": true, "isSigner": false },
        { "name": "buyerUsdcAccount", "isMut": true, "isSigner": false },
        { "name": "seller", "isMut": true, "isSigner": false },
        { "name": "sellerUsdcAccount", "isMut": true, "isSigner": false },
        { "name": "projectMint", "isMut": false, "isSigner": false },
        { "name": "stablecoinMint", "isMut": false, "isSigner": false },
        { "name": "escrowVault", "isMut": true, "isSigner": false },
        { "name": "vaultAuthority", "isMut": false, "isSigner": false },
        { "name": "sellOrder", "isMut": true, "isSigner": false },
        { "name": "feeDestinationUsdc", "isMut": true, "isSigner": false },
        { "name": "buyerEligibility", "isMut": false, "isSigner": false },
        { "name": "projectAccount", "isMut": false, "isSigner": false },
        { "name": "projectPause", "isMut": false, "isSigner": false },
        { "name": "distributionControl", "isMut": false, "isSigner": false },
        { "name": "tokenProgram", "isMut": false, "isSigner": false },
        { "name": "stablecoinProgram", "isMut": false, "isSigner": false }
      ],
      "args": [{ "name": "buyAmount", "type": "u64" }]
    }
  ],
  "accounts": [
    {
      "name": "MarketConfig",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "authority", "type": "publicKey" },
          { "name": "feeDestination", "type": "publicKey" },
          { "name": "feeBasisPoints", "type": "u16" },
          { "name": "isPaused", "type": "bool" },
          { "name": "projectRegistryProgram", "type": "publicKey" },
          { "name": "complianceProgram", "type": "publicKey" },
          { "name": "distributionProgram", "type": "publicKey" },
          { "name": "bump", "type": "u8" },
          { "name": "padding", "type": { "array": ["u8", 32] } }
        ]
      }
    },
    {
      "name": "ProjectPause",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "projectMint", "type": "publicKey" },
          { "name": "isPaused", "type": "bool" },
          { "name": "bump", "type": "u8" }
        ]
      }
    },
    {
      "name": "SellOrder",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "seller", "type": "publicKey" },
          { "name": "projectMint", "type": "publicKey" },
          { "name": "originalQuantity", "type": "u64" },
          { "name": "remainingQuantity", "type": "u64" },
          { "name": "pricePerToken", "type": "u64" },
          { "name": "sequence", "type": "u64" },
          { "name": "createdAt", "type": "i64" },
          { "name": "bump", "type": "u8" }
        ]
      }
    },
    {
      "name": "InvestorEligibilityAccount",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "wallet", "type": "publicKey" },
          { "name": "kycStatus", "type": { "defined": "KycStatus" } },
          { "name": "amlStatus", "type": { "defined": "AmlStatus" } },
          { "name": "identityHash", "type": { "array": ["u8", 32] } },
          { "name": "investmentAllowed", "type": "bool" },
          { "name": "transferAllowed", "type": "bool" },
          { "name": "approvalTimestamp", "type": "i64" },
          { "name": "expiryTimestamp", "type": "i64" },
          { "name": "reverificationRequired", "type": "bool" },
          { "name": "lockupBypass", "type": "bool" },
          { "name": "recordedBy", "type": "publicKey" },
          { "name": "bump", "type": "u8" }
        ]
      }
    }
  ],
  "types": [
    {
      "name": "ProjectAccount",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "projectId", "type": "u64" },
          { "name": "registry", "type": "publicKey" },
          { "name": "creator", "type": "publicKey" },
          { "name": "name", "type": "string" },
          { "name": "symbol", "type": "string" },
          { "name": "uri", "type": "string" },
          { "name": "supplyCap", "type": "u64" },
          { "name": "tokensIssued", "type": "u64" },
          { "name": "minInvestmentUsdc", "type": "u64" },
          { "name": "maxInvestmentUsdc", "type": "u64" },
          { "name": "tokenPriceUsdc", "type": "u64" },
          { "name": "acceptedStablecoin", "type": "publicKey" },
          { "name": "treasuryWallet", "type": "publicKey" },
          { "name": "mint", "type": "publicKey" },
          { "name": "lockupEndTs", "type": "i64" },
          { "name": "subscriptionStart", "type": "i64" },
          { "name": "subscriptionEnd", "type": "i64" },
          { "name": "createdAt", "type": "i64" },
          { "name": "distributionCadence", "type": "u8" },
          { "name": "durationMonths", "type": "u8" },
          { "name": "distributionMode", "type": "u8" },
          { "name": "status", "type": { "defined": "ProjectStatus" } },
          { "name": "isPaused", "type": "bool" },
          { "name": "mintAuthorityRevoked", "type": "bool" },
          { "name": "roundLimitTokens", "type": "u64" },
          { "name": "currentRoundIssued", "type": "u64" },
          { "name": "assetType", "type": { "defined": "AssetType" } },
          { "name": "bump", "type": "u8" },
          { "name": "tokenDecimals", "type": "u8" },
          { "name": "padding", "type": { "array": ["u8", 41] } }
        ]
      }
    },
    {
      "name": "DistributionControl",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "admin", "type": "publicKey" },
          { "name": "isPaused", "type": "bool" },
          { "name": "bump", "type": "u8" },
          { "name": "padding", "type": { "array": ["u8", 64] } }
        ]
      }
    },
    {
      "name": "ProjectStatus",
      "type": {
        "kind": "enum",
        "variants": [
          { "name": "Draft" },
          { "name": "Funding" },
          { "name": "Funded" },
          { "name": "Active" },
          { "name": "Completed" },
          { "name": "Canceled" }
        ]
      }
    },
    {
      "name": "AssetType",
      "type": {
        "kind": "enum",
        "variants": [
          { "name": "RealEstate" },
          { "name": "Mining" },
          { "name": "Other" }
        ]
      }
    },
    {
      "name": "KycStatus",
      "type": {
        "kind": "enum",
        "variants": [
          { "name": "Pending" },
          { "name": "Approved" },
          { "name": "Rejected" },
          { "name": "Expired" }
        ]
      }
    },
    {
      "name": "AmlStatus",
      "type": {
        "kind": "enum",
        "variants": [
          { "name": "Clear" },
          { "name": "Flagged" },
          { "name": "Blocked" }
        ]
      }
    }
  ],
  "events": [
    {
      "name": "OrderCancelled",
      "fields": [
        { "name": "orderId", "type": "publicKey", "index": false },
        { "name": "seller", "type": "publicKey", "index": false },
        { "name": "projectMint", "type": "publicKey", "index": false },
        { "name": "amountRefunded", "type": "u64", "index": false },
        { "name": "timestamp", "type": "i64", "index": false }
      ]
    },
    {
      "name": "OrderCreated",
      "fields": [
        { "name": "orderId", "type": "publicKey", "index": false },
        { "name": "seller", "type": "publicKey", "index": false },
        { "name": "projectMint", "type": "publicKey", "index": false },
        { "name": "amount", "type": "u64", "index": false },
        { "name": "pricePerToken", "type": "u64", "index": false },
        { "name": "timestamp", "type": "i64", "index": false }
      ]
    },
    {
      "name": "OrderFilled",
      "fields": [
        { "name": "orderId", "type": "publicKey", "index": false },
        { "name": "buyer", "type": "publicKey", "index": false },
        { "name": "seller", "type": "publicKey", "index": false },
        { "name": "projectMint", "type": "publicKey", "index": false },
        { "name": "amountFilled", "type": "u64", "index": false },
        { "name": "pricePerToken", "type": "u64", "index": false },
        { "name": "feeCharged", "type": "u64", "index": false },
        { "name": "timestamp", "type": "i64", "index": false }
      ]
    }
  ],
  "errors": [
    {
      "code": 6000,
      "name": "Unauthorized",
      "msg": "Caller is not authorized to perform this action"
    },
    {
      "code": 6001,
      "name": "GlobalPause",
      "msg": "Secondary trading is globally paused"
    },
    {
      "code": 6002,
      "name": "ProjectPause",
      "msg": "Trading is paused for this project"
    },
    {
      "code": 6003,
      "name": "InvalidStatus",
      "msg": "Project is not in Active status"
    },
    {
      "code": 6004,
      "name": "LockupActive",
      "msg": "Project lock-up period is active"
    },
    {
      "code": 6005,
      "name": "SellerNotApproved",
      "msg": "Seller wallet is not KYC-approved or transfer not allowed"
    },
    {
      "code": 6006,
      "name": "BuyerNotApproved",
      "msg": "Buyer wallet is not KYC-approved or transfer not allowed"
    },
    {
      "code": 6007,
      "name": "InsufficientRemaining",
      "msg": "Order does not have enough remaining tokens to fill this amount"
    },
    { "code": 6008, "name": "Overflow", "msg": "Arithmetic overflow" },
    { "code": 6009, "name": "InvalidMint", "msg": "Mint address mismatch" },
    {
      "code": 6010,
      "name": "InvalidStablecoin",
      "msg": "Stablecoin mint mismatch"
    },
    { "code": 6011, "name": "InvalidEscrow", "msg": "Escrow vault mismatch" },
    {
      "code": 6012,
      "name": "InvalidRegistry",
      "msg": "Project registry program mismatch"
    },
    {
      "code": 6013,
      "name": "InvalidCompliance",
      "msg": "Compliance program mismatch"
    },
    {
      "code": 6014,
      "name": "InvalidDistribution",
      "msg": "Distribution program mismatch"
    }
  ]
}
